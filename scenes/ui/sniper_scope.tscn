[gd_scene load_steps=4 format=3 uid="uid://k5g6musou22s"]

[ext_resource type="Script" uid="uid://cvc38rupamx46" path="res://scenes/ui/sniper_scope.gd" id="1_script"]

[sub_resource type="Shader" id="Shader_scope"]
code = "shader_type canvas_item;

uniform float lens_radius = 0.35;
uniform float scope_thickness = 0.02;
uniform float aspect_ratio = 1.777777; // 16:9 default
uniform vec4 border_color : source_color = vec4(0.0, 0.0, 0.0, 1.0);

void fragment() {
	vec2 center_uv = UV - vec2(0.5);
	
	// Multiply x by aspect ratio to keep it perfectly circular
	center_uv.x *= aspect_ratio;
	
	float dist = length(center_uv);
	
	if (dist > lens_radius) {
		COLOR = border_color;
	} else if (dist > lens_radius - scope_thickness) {
		// Draw a thick black ring immediately around the lens
		COLOR = vec4(0.0, 0.0, 0.0, 1.0);
	} else {
		// Transparent center
		COLOR = vec4(0.0, 0.0, 0.0, 0.0);
	}
}"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_scope"]
